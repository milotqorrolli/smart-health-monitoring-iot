# Copy this file to .env and fill in your real values.
# .env is in .gitignore and will never be committed.

ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your-email@gmail.com
ALERT_SMTP_PASSWORD=your-app-password

ALERT_DOCTOR_EMAIL=doctor@hospital.com
ALERT_DOCTOR_NAME=Dr. Arben Krasniqi

ALERT_MIN_SEVERITY=HIGH
ALERT_COOLDOWN_MINUTES=5
DASHBOARD_BASE_URL=http://localhost:5000

# Gmail: use App Password (not account password)
# https://myaccount.google.com/apppasswords
# MailHog local test: ALERT_SMTP_HOST=mailhog ALERT_SMTP_PORT=1025
